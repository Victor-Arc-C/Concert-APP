# Set these on the hosting platform. Never copy local accounts/secrets into production.
APP_ENV=production
APP_URL=https://concerts.example.com
DATABASE_URL=
TICKETMASTER_API_KEY=
# Trip Intelligence (optional). SNCF open API token: real train/coach timetables, no prices.
SNCF_API_KEY=
# Nuitée LiteAPI key (sand_… = test prices, never used in production; prod_… = live rates).
LITEAPI_API_KEY=
# Your LiteAPI white-label checkout (https). Without it hotels show prices but no booking link.
LITEAPI_WHITELABEL_URL=
AUTO_CONCERT_CHECKS=false
SPOTIFY_APPROVED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Private beta: comma-separated invite codes (empty = open signup).
BETA_INVITE_CODES=
# Privacy page: data controller name and privacy contact email (required before inviting users).
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=

# Web Push (see docs/PUSH_NOTIFICATIONS.md). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Omio affiliate tracking link (see docs/TRAVEL_PROVIDERS.md)
OMIO_AFFILIATE_URL=

# Travelpayouts flight fares (see docs/TRAVEL_PROVIDERS.md)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
