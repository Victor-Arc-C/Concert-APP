# Local profile. For separate dev/prod profiles, see config/environments.
APP_ENV=local
# No keys required for the local sample experience.
APP_URL=http://127.0.0.1:3000
# Privacy page: data controller name and privacy contact email.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
# For managed Postgres. Leave empty for single-process, persistent local PGlite.
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/encore
TICKETMASTER_API_KEY=
# Trip Intelligence (optional). SNCF open API token: real train/coach timetables, no prices.
SNCF_API_KEY=
# Nuitée LiteAPI key (sand_… = test prices, never used in production; prod_… = live rates).
LITEAPI_API_KEY=
# Your LiteAPI white-label checkout (https). Without it hotels show prices but no booking link.
LITEAPI_WHITELABEL_URL=
# Single-process local server only. Checks on startup and every five minutes; artist cache is one hour.
AUTO_CONCERT_CHECKS=false
# Enable ONLY after written approval for this use and allowlisting pilot accounts.
SPOTIFY_APPROVED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32. Required for external scheduled jobs.
CRON_SECRET=
# Private beta: comma-separated invite codes. Leave empty for open signup.
BETA_INVITE_CODES=
# Omio Impact programme: obtain YOUR numeric publisher/partner ID from your approved account.
# Enable only after Omio programme activation. Empty/invalid ID or disabled = no Omio links.
# See docs/OMIO.md. The legacy OMIO_AFFILIATE_URL is no longer used.
OMIO_ENABLED=false
OMIO_PARTNER_ID=
# Booking.com via CJ (booking.cj.com → Create a Deep Link): the tracking link's base without
# its query, e.g. https://www.dpbolvw.net/click-<property>-<ad>. Empty = plain Booking links.
BOOKING_AFFILIATE_URL=
# Travelpayouts (Aviasales Data API): flight fares for the concert day. Token from the
# Travelpayouts dashboard; marker = your numeric partner ID (for commission). Empty = no fare.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Web Push notifications (installable app on iPhone/Android, desktop browsers).
# Generate once with: npx web-push generate-vapid-keys. Keep the private key secret;
# changing the pair invalidates every existing device subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or an https:// URL.
# Defaults to PRIVACY_CONTACT_EMAIL, then APP_URL.
VAPID_SUBJECT=
# Weekly metrics report only (npm run metrics:weekly), never used by the app.
# Paste the Neon production connection string here to read production metrics.
METRICS_DATABASE_URL=
# Staff/test accounts to leave out: emails, user IDs or @domains, comma-separated.
# @example.test is always excluded.
METRICS_EXCLUDE=
