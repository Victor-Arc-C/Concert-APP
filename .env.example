# Local profile. For separate dev/prod profiles, see config/environments.
APP_ENV=local
# No keys required for the local sample experience.
APP_URL=http://127.0.0.1:3000
# Privacy page: data controller name and privacy contact email.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
# For managed Postgres. Leave empty for single-process, persistent local PGlite.
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/encore
TICKETMASTER_API_KEY=
# Single-process local server only. Checks on startup and every five minutes; artist cache is one hour.
AUTO_CONCERT_CHECKS=false
# Enable ONLY after written approval for this use and allowlisting pilot accounts.
SPOTIFY_APPROVED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32. Required for external scheduled jobs.
CRON_SECRET=
# Private beta: comma-separated invite codes. Leave empty for open signup.
BETA_INVITE_CODES=
